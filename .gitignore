# ===========================
# 1. SISTEMA Y EDITORES
# ===========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.suo
*.ntvs*
*.njsproj
*.sln

# ===========================
# 2. SEGURIDAD (¡CRÍTICO!)
# ===========================
# Ignora todos los archivos de entorno en cualquier carpeta
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Excepción: Si tienes un archivo de ejemplo, ese sí se sube
!.env.example

# ===========================
# 3. NODE.JS (Frontend y Backend)
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===========================
# 4. FRONTEND (React/Vite)
# ===========================
frontend/dist/
frontend/build/
frontend/coverage/
frontend/*.local

# ===========================
# 5. BACKEND (Express)
# ===========================
# Ignora las fotos subidas, pero mantén la carpeta 'uploads'
backend-api/uploads/*
!backend-api/uploads/.gitkeep
backend-api/coverage/

# ===========================
# 6. PYTHON / IA (Service)
# ===========================
# Archivos compilados y caché
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Entornos virtuales (varios nombres comunes)
venv/
.venv/
env/
ia-service-python/venv/

# ===========================
# 7. MODELOS DE IA (Pesados)
# ===========================
# GitHub bloquea archivos >100MB. Si tus modelos pesan menos, 
# puedes comentar estas líneas con # para subirlos.
*.h5
*.pkl
*.pt
*.keras